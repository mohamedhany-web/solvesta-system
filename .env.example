APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Hostinger SMTP — ضع كلمة مرور صندوق البريد في MAIL_PASSWORD
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@s0lvesta.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@s0lvesta.com
MAIL_FROM_NAME="${APP_NAME}"

# IMAP لاستقبال البريد داخل النظام (Hostinger)
MAIL_IMAP_HOST=imap.hostinger.com
MAIL_IMAP_PORT=993
MAIL_IMAP_ENCRYPTION=ssl

# Comma-separated admin inboxes for client portal alerts (ticket, website issue, meeting request).
CLIENT_PORTAL_ALERT_EMAIL=

# تنبيهات Gmail لنشاط موظفي المبيعات (فاصلة بين عدة عناوين)
SALES_ALERT_EMAIL=
# نسبة عمولة المبيعات % من قيمة الصفقات Won
SALES_COMMISSION_RATE=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Disk used for job/internship CV uploads (Cloudflare R2). Falls back to public if R2 is not configured.
CV_DISK=r2

VITE_APP_NAME="${APP_NAME}"

# GitHub — بيئة التطوير (إنشاء فروع وPR تلقائياً)
GITHUB_TOKEN=
GITHUB_ORG=Solvesta-Company
